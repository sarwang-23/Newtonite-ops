# Newtonite Operations Under Pressure - Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# JWT Secret for Session Auth
JWT_SECRET=newtonite-operations-under-pressure-secure-jwt-token-2026

# Database Connection
# If unset or empty, defaults to local high-performance SQLite database (dev.db)
# For PostgreSQL (Docker Compose / Prod): postgresql://postgres:postgres@localhost:5432/newtonite_ops
DATABASE_URL=

# Outbox Worker Polling Interval (in milliseconds)
OUTBOX_POLL_INTERVAL_MS=3000
